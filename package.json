{
  "name": "react-slot-system",
  "version": "0.1.0",
  "type": "module",
  "description": "Vue-style named slots for React: declare <Slot> in your component, fill from parents via <Template> using the hasSlots HOC.",
  "keywords": [
    "react",
    "slots",
    "react-slots",
    "vuejs-slots",
    "react-package",
    "react-library"
  ],
  "main": "dist/main.min.js",
  "module": "dist/main.esm.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/main.esm.js",
      "require": "./dist/main.min.js"
    }
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "vite build",
    "bump": "node scripts/bumper.js",
    "test": "vitest",
    "preview": "vite preview",
    "dev:demo": "vite --config demo/vite.config.demo.ts",
    "build:demo": "vite build --config demo/vite.config.demo.ts"
  },
  "author": "Hichem Taboukouyout <hichem.taboukouyout@hichemtab-tech.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HichemTab-tech/react-slot-system.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/HichemTab-tech/react-slot-system/issues"
  },
  "homepage": "https://github.com/HichemTab-tech/react-slot-system#readme",
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "classnames": "^2.5.1",
    "jsdom": "^29.0.1",
    "react": "^19.2.0",
    "react-ctx-selector": "^0.7.3",
    "react-dom": "^19.2.0",
    "react-exposed-states": "^1.0.5",
    "tailwindcss": "^4.1.14",
    "typescript": "^6.0.2",
    "vite": "^8.0.2",
    "vite-plugin-banner": "^0.8.1",
    "vite-plugin-css-injected-by-js": "^5.0.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.15"
  }
}
